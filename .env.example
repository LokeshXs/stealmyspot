# ---- Database ----
DATABASE_URL="postgresql://outbid:outbid@localhost:5432/outbid?schema=public"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Branding ----
NEXT_PUBLIC_SITE_NAME="Steal My Spot"
NEXT_PUBLIC_SITE_ACCENT="Spot"
NEXT_PUBLIC_TAGLINE="Every spot on this list is for sale. Yours included."
NEXT_PUBLIC_TAGLINE_EMPHASIS="Outbid the number beside a name and the spot is yours."

# ---- Payments ----
# `mock` runs the whole bid -> pay -> rank flow locally with no Dodo account.
# `dodo` hits the real Dodo Payments API.
PAYMENT_PROVIDER="mock"

DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# The one-time "Leaderboard rank" product with Pay What You Want enabled (min $1.00)
DODO_PRODUCT_ID=""
