# ---- Database ----
DATABASE_URL="postgresql://outbid:outbid@localhost:5432/outbid?schema=public"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Branding (name still undecided; swap freely) ----
NEXT_PUBLIC_SITE_NAME="outbid"
NEXT_PUBLIC_SITE_TLD=".lol"
NEXT_PUBLIC_TAGLINE="One list, ordered by price. The only thing holding a position is the number beside it."
NEXT_PUBLIC_TAGLINE_EMPHASIS="Nothing here is editorial. Every place on this page was paid for."

# ---- Payments ----
# `mock` runs the whole bid -> pay -> rank flow locally with no Dodo account.
# `dodo` hits the real Dodo Payments API.
PAYMENT_PROVIDER="mock"

DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# The one-time "Leaderboard rank" product with Pay What You Want enabled (min $1.00)
DODO_PRODUCT_ID=""
